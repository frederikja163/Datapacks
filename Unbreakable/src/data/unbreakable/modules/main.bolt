append function_tag minecraft:load{
  "values": ["unbreakable:load"]
}

function unbreakable:load:
  scoreboard objectives add unbreakable trigger
  scoreboard objectives add unbreakable_toggle dummy
  scoreboard objectives add unbreakable_initialized dummy


append function_tag minecraft:tick {
  "values": ["unbreakable:tick"]
}

function unbreakable:tick:
  execute as @a[scores={unbreakable=1..}] run function unbreakable:trigger/
  scoreboard players enable @a unbreakable

  execute as @a[scores={unbreakable_initialized=0..0}] run scoreboard players set @s unbreakable_initialized 1

  execute as @a[scores={unbreakable_toggle=1..1}] run function unbreakable:player_on
  execute as @a[scores={unbreakable_toggle=0..0}] run function unbreakable:player_off


function unbreakable:trigger/:
  execute if score @s unbreakable_toggle matches 0..0 run function unbreakable:trigger/on
  execute if score @s unbreakable_toggle matches 1..1 run function unbreakable:trigger/off
  scoreboard players operation @s unbreakable_toggle = @s unbreakable
  scoreboard players set @s unbreakable 0

function unbreakable:trigger/on:
  tellraw @s:
    - text: "[Unbreakable]"
      color: gray
    - text: " Your items can no longer break. To turn your items breakable write '"
      color: white
    - text: "/trigger unbreakable"
      color: dark_gray
      underlined: true
      click_event:
        action: run_command
        command: "/trigger unbreakable"
      hover_event:
        action: show_text
        value: "trigger unbreakable"
    - text: "'"
      color: white
  scoreboard players set @s unbreakable 1
function unbreakable:trigger/off:
  tellraw @s:
    - text: "[Unbreakable]"
      color: gray
    - text: " Your items can now break. To turn your items breakable write '"
      color: white
    - text: "/trigger unbreakable"
      color: dark_gray
      underlined: true
      click_event:
        action: run_command
        command: "/trigger unbreakable"
      hover_event:
        action: show_text
        value: "trigger unbreakable"
    - text: "'"
  scoreboard players set @s unbreakable 0

function unbreakable:player_off:
  execute if predicate unbreakable:body_unbreakable run item modify entity @s armor.body unbreakable:make_breakable
  execute if predicate unbreakable:chest_unbreakable run item modify entity @s armor.chest unbreakable:make_breakable
  execute if predicate unbreakable:feet_unbreakable run item modify entity @s armor.feet unbreakable:make_breakable
  execute if predicate unbreakable:head_unbreakable run item modify entity @s armor.head unbreakable:make_breakable
  execute if predicate unbreakable:legs_unbreakable run item modify entity @s armor.legs unbreakable:make_breakable

  execute if predicate unbreakable:mainhand_unbreakable run item modify entity @s weapon.mainhand unbreakable:make_breakable
  execute if predicate unbreakable:offhand_unbreakable run item modify entity @s weapon.offhand unbreakable:make_breakable

function unbreakable:player_on:
  execute if predicate unbreakable:body_breakable run item modify entity @s armor.body unbreakable:make_unbreakable
  execute if predicate unbreakable:chest_breakable run item modify entity @s armor.chest unbreakable:make_unbreakable
  execute if predicate unbreakable:feet_breakable run item modify entity @s armor.feet unbreakable:make_unbreakable
  execute if predicate unbreakable:head_breakable run item modify entity @s armor.head unbreakable:make_unbreakable
  execute if predicate unbreakable:legs_breakable run item modify entity @s armor.legs unbreakable:make_unbreakable

  execute if predicate unbreakable:mainhand_breakable run item modify entity @s weapon.mainhand unbreakable:make_unbreakable
  execute if predicate unbreakable:offhand_breakable run item modify entity @s weapon.offhand unbreakable:make_unbreakable

itemTag = "#unbreakable:items"
append item_tag unbreakable:items{
  "values": ["#minecraft:enchantable/durability"]
}

def make_predicate(name, equipment):
  predicate name{
    "condition": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
      "equipment": equipment
    }
  }

def make_predicates(name):
  obj_breakable = {name:{items: itemTag}}
  id_breakable = f"unbreakable:{name}_breakable"
  make_predicate(id_breakable, obj_breakable)
  obj_unbreakable = {name:{"items": itemTag,"components": {"unbreakable": {}}}}
  id_unbreakable = f"unbreakable:{name}_unbreakable"
  make_predicate(id_unbreakable, obj_unbreakable)

make_predicates("body")
make_predicates("chest")
make_predicates("feet")
make_predicates("head")
make_predicates("legs")
make_predicates("mainhand")
make_predicates("offhand")

item_modifier unbreakable:make_breakable {
  "function": "set_components",
  "components": {
    "!minecraft:unbreakable": { }
  }
}

item_modifier unbreakable:make_unbreakable {
  "function": "set_components",
  "components": {
    "minecraft:unbreakable": { }
  }
}