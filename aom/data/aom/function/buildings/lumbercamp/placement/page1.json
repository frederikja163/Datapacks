[
    "",
    ${toolbar},
    {
        "text":"\\nTool crafter",
        "bold": true
    },
    "\\nUnlocks wooden tools\\nUnlocked: ",
    {
        "nbt": "villages.$(village_name).unlocks.wooden_tools",
        "storage": "aom:data",
        "interpret": true
    },
    {
        "text": "\\n[Hire]",
        "color": "green",
        "hover_event": {
            "action": "show_text",
            "value": "Hire a villager if not unlocked already."
        },
        "click_event": {
            "action": "run_command",
            "command": "/function aom:buildings/lumbercamp/unlock_tools with storage aom:data villages.$(village_name).$(building_name).$(placement)"
        }
    }
]
