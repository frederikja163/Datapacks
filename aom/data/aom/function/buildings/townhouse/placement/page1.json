[
    "",
    ${toolbar},
    "\\n",
    "Players ",
    {
        "score": {
            "name": "$(village_name)",
            "objective": "aom.villages.player_count"
        }
    },
    "\\n",
    {
        "text": "[Join]",
        "color": "green",
        "hover_event": {
            "action": "show_text",
            "value": "Join village"
        },
        "click_event": {
            "action": "run_command",
            "command": "/function aom:buildings/townhouse/join with storage aom:data villages.$(village_name).$(building_name)"
        }
    }
]
