{
    "text": "[Move]",
    "color": "blue",
    "hover_event": {
        "action": "show_text",
        "value": "Move the house somewhere else (Coming soon)"
    },
    "click_event": {
        "action": "run_command",
        "command": "/function aom:start_move"
    }
},
{
    "text": "[Delete]",
    "color": "red",
    "hover_event": {
        "action": "show_text",
        "value": "Delete placement"
    },
    "click_event": {
        "action": "run_command",
        "command": "/function aom:delete_placement with storage aom:data villages.$(village_name).$(building_name).$(placement)"
    }
},
"\\n$(village_name)/$(building_name)\\n"
